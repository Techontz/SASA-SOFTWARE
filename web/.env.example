# ---------------------------------------------------------------------------
# SASA web — environment
#
# Copy to .env.local for development. .env.local is never committed.
# Production values live in .env.production, which is committed because every
# NEXT_PUBLIC_* value is inlined into the browser bundle and cannot be secret.
# ---------------------------------------------------------------------------

# The SASA API, including the /api/v1 suffix and no trailing slash.
#   development: http://localhost:8010/api/v1
#   production:  https://sasa.agizastore.xyz/api/v1
#
# Required. A production build without it fails every request with a message
# saying so, rather than silently pointing at localhost.
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# Shows the demo account list on the sign-in screen. Never true in production.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
