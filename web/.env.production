# Production build configuration.
#
# Committed on purpose. Every value here is NEXT_PUBLIC_*, which Next inlines
# into the JavaScript the browser downloads — so none of it can be secret, and
# keeping it in the repository means a production build is reproducible from a
# clean clone instead of depending on what happened to be on someone's laptop.
#
# NEVER add a value here that is not NEXT_PUBLIC_*. A server-side secret in
# this file would be committed; put those in the hosting platform's own
# environment settings.

NEXT_PUBLIC_API_URL=https://sasa.agizastore.xyz/api/v1

# The demo account list belongs on a demo, never on the real register.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
