# ---------------------------------------------------------------------------
# SASA — Stakeholder Intelligence & Voice :: Backend environment
# ---------------------------------------------------------------------------
APP_NAME=SASA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Public URL of the Next.js application (used in e-mails and CORS)
SASA_WEB_URL=http://localhost:3010
# Comma-separated list of browser origins allowed to call the API.
SASA_CORS_ORIGINS="http://localhost:3010"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (server source of truth) -------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sasa
DB_USERNAME=root
DB_PASSWORD=

# --- Session / cache / queue ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sasa.africa"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth -------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3010,127.0.0.1:3010
SASA_TOKEN_TTL_MINUTES=720
SASA_ADMIN_TOKEN_TTL_MINUTES=240
SASA_REQUIRE_MFA_FOR_ADMINS=false

# --- Files ------------------------------------------------------------------
SASA_ATTACHMENT_MAX_MB=25
SASA_SIGNED_URL_TTL_MINUTES=10
SASA_VIRUS_SCAN_ENABLED=false
SASA_VIRUS_SCAN_COMMAND="clamdscan --no-summary --stdout"

# --- AI / Voice -------------------------------------------------------------
# Providers: null (deterministic offline stub), openai, anthropic
SASA_AI_PROVIDER=null
SASA_AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Voice telephony provider: null | twilio | africastalking
SASA_VOICE_PROVIDER=null
SASA_VOICE_WEBHOOK_SECRET=change-me-in-production
SASA_VOICE_SOFT_CAP_SECONDS=120

# --- Backups ----------------------------------------------------------------
SASA_BACKUP_PATH=storage/app/backups
SASA_BACKUP_RETENTION_DAYS=30
